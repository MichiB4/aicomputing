# Set these as process environment variables; this file is documentation, not auto-loaded.
# Alternatively set OPENAI_API_KEY in the process environment.
PAPER_PARSER_MODEL=gpt-6.1-terra
PAPER_PARSER_TIMEOUT=120
# Optional per-call token limit, if supported by the selected model.
# PAPER_PARSER_MAX_OUTPUT_TOKENS=4096
# Optional: path to a local file containing one OPENAI_API_KEY assignment.
# PAPER_PARSER_KEY_FILE=C:\path\to\credentials.env
# Optional cost estimates, USD per million tokens; verify rates before a study.
# PAPER_PARSER_INPUT_PRICE=1
# PAPER_PARSER_OUTPUT_PRICE=5
